git init -- used for intialising the git in local to track the files
git status -- to know the status of files
git add .    -- it will add all the files in the directory to the staging
git add filename  -- it will add particular file only to the staging
git commit -m "This is the first commit"   _ commiting the files to git(kind of final file)
git log -- to check the commited logs

git checkout commitid --- it will revert back to previous version of the provided commit id
git rm --cached filename -- to remove the file from staging

